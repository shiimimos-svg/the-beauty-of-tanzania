<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - The Beauty of Tanzania</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #111827;
            --accent: #059669;
            --bg: #f9fafb;
            --card-bg: #ffffff;
            --text: #374151;
            --gray: #6b7280;
            --danger: #dc2626;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Plus Jakarta Sans', sans-serif; }
        body { background-color: var(--bg); color: var(--text); line-height: 1.6; }
        
        header { background: var(--card-bg); border-bottom: 1px solid #e5e7eb; position: sticky; top: 0; z-index: 100; }
        .nav-container { max-width: 1200px; margin: 0 auto; padding: 1.2rem 2rem; display: flex; justify-content: space-between; align-items: center; }
        .logo { font-size: 1.25rem; font-weight: 700; color: var(--primary); text-decoration: none; }
        .logo span { color: var(--accent); }
        .nav-links a { color: var(--gray); text-decoration: none; margin-left: 2rem; font-weight: 500; font-size: 0.95rem; }
        .nav-links a:hover { color: var(--accent); }

        .container { max-width: 1200px; margin: 0 auto; padding: 2.5rem 2rem; }
        h1 { font-size: 2rem; font-weight: 700; color: var(--primary); margin-bottom: 2rem; }
        
        .admin-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 2.5rem; }
        
        .panel-card { background: var(--card-bg); padding: 2rem; border-radius: 12px; border: 1px solid #e5e7eb; height: fit-content; }
        .panel-card h2 { font-size: 1.25rem; font-weight: 600; color: var(--primary); margin-bottom: 1.5rem; }

        .form-group { margin-bottom: 1.25rem; }
        .form-group label { display: block; font-weight: 500; font-size: 0.9rem; margin-bottom: 0.5rem; color: var(--primary); }
        .form-control { width: 100%; padding: 0.75rem 1rem; border: 1px solid #d1d5db; border-radius: 8px; font-size: 0.95rem; outline: none; }
        .form-control:focus { border-color: var(--accent); }
        textarea.form-control { resize: vertical; height: 100px; }
        
        .btn { background: var(--accent); color: white; border: none; padding: 0.75rem 1.5rem; border-radius: 8px; font-weight: 600; cursor: pointer; width: 100%; font-size: 1rem; }
        .btn:hover { background: #047857; }
        .btn-danger { background: var(--danger); padding: 0.4rem 0.8rem; font-size: 0.85rem; width: auto; }
        .btn-danger:hover { background: #b91c1c; }

        .posts-list, .messages-list { display: flex; flex-direction: column; gap: 1rem; }
        .post-item, .message-item { background: var(--card-bg); padding: 1rem 1.25rem; border-radius: 8px; border: 1px solid #e5e7eb; display: flex; justify-content: space-between; align-items: center; }
        .post-info { display: flex; align-items: center; gap: 1rem; }
        .post-info img { width: 50px; height: 50px; object-fit: cover; border-radius: 6px; }
        .post-title { font-weight: 600; color: var(--primary); font-size: 0.95rem; }
        .post-desc { color: var(--gray); font-size: 0.85rem; }

        .message-box { background: var(--card-bg); padding: 1.25rem; border-radius: 8px; border: 1px solid #e5e7eb; margin-bottom: 1rem; }
        .message-header { display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.9rem; }
        .message-header strong { color: var(--primary); }
        .message-header span { color: var(--gray); font-size: 0.85rem; }
        .message-body { color: var(--text); font-size: 0.95rem; }

        @media (max-width: 900px) {
            .admin-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <header>
        <div class="nav-container">
            <a href="/" class="logo">The Beauty of <span>Tanzania</span> (Admin)</a>
            <div class="nav-links">
                <a href="/">View Live Site</a>
            </div>
        </div>
    </header>

    <div class="container">
        <h1>Dashboard ya Usimamizi</h1>

        <div class="admin-grid">
            <!-- Sehemu ya Kuweka Picha Mpya -->
            <div class="panel-card">
                <h2>Weka Picha Mpya</h2>
                <form action="/admin/add-post" method="POST" enctype="multipart/form-data">
                    <div class="form-group">
                        <label>Jina la Kivutio</label>
                        <input type="text" name="title" class="form-control" required placeholder="Mf. Ngorongoro Crater">
                    </div>
                    <div class="form-group">
                        <label>Pakia Picha (File)</label>
                        <input type="file" name="image" class="form-control" accept="image/*">
                    </div>
                    <div class="form-group">
                        <label>Au Weka Link ya Picha (URL)</label>
                        <input type="url" name="imageUrl" class="form-control" placeholder="https://...">
                    </div>
                    <div class="form-group">
                        <label>Maelezo Mafupi</label>
                        <textarea name="description" class="form-control" required placeholder="Eleza kwa ufupi kuhusu picha hii..."></textarea>
                    </div>
                    <button type="submit" class="btn">Chapisha Picha</button>
                </form>
            </div>

            <!-- Sehemu ya Kusimamia Picha Zilizopo na Meseji -->
            <div>
                <div class="panel-card" style="margin-bottom: 2rem;">
                    <h2>Picha Zilizopo kwenye Tovuti (<%= posts.length %>)</h2>
                    <div class="posts-list">
                        <% if (posts.length === 0) { %>
                            <p style="color: var(--gray); font-size: 0.9rem;">Hakuna picha zilizowekwa bado.</p>
                        <% } %>
                        <% posts.forEach(post => { %>
                            <div class="post-item">
                                <div class="post-info">
                                    <img src="<%= post.imageUrl %>" alt="">
                                    <div>
                                        <div class="post-title"><%= post.title %></div>
                                        <div class="post-desc"><%= post.description.substring(0, 40) %>...</div>
                                    </div>
                                </div>
                                <form action="/admin/delete-post/<%= post.id %>" method="POST" onsubmit="return confirm('Una uhakika unataka kufuta picha hii?');">
                                    <button type="submit" class="btn btn-danger">Futa</button>
                                </form>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <div class="panel-card">
                    <h2>Meseji na Maswali kutoka kwa Watalii (<%= messages.length %>)</h2>
                    <div class="messages-list">
                        <% if (messages.length === 0) { %>
                            <p style="color: var(--gray); font-size: 0.9rem;">Hakuna meseji zilizopokelewa bado.</p>
                        <% } %>
                        <% messages.forEach(msg => { %>
                            <div class="message-box">
                                <div class="message-header">
                                    <strong><%= msg.name %> (<%= msg.email %>)</strong>
                                    <span><%= msg.date %></span>
                                </div>
                                <div class="message-body"><%= msg.message %></div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>