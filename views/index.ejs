<!DOCTYPE html>
<html lang="sw">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Beauty of Tanzania</title>
    <style>
        :root {
            --primary: #10b981;
            --primary-hover: #059669;
            --text-dark: #111827;
            --text-muted: #4b5563;
        }

        body {
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: var(--text-dark);
            background-color: #ffffff;
        }

        /* Top Announcement Bar */
        .top-bar {
            background-color: var(--primary);
            color: white;
            text-align: center;
            padding: 10px 20px;
            font-size: 14px;
            font-weight: 500;
        }

        /* Navbar */
        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 40px;
            background: #ffffff;
            border-bottom: 1px solid #f3f4f6;
        }

        .logo {
            font-size: 20px;
            font-weight: bold;
            color: var(--text-dark);
            text-decoration: none;
        }

        .logo span {
            color: var(--primary);
        }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--text-muted);
            font-weight: 500;
            font-size: 15px;
            transition: color 0.2s;
        }

        .nav-links a:hover {
            color: var(--primary);
        }

        /* Hero Section */
        .hero {
            text-align: center;
            padding: 80px 20px 40px 20px;
        }

        .hero h1 {
            font-size: 48px;
            font-weight: 800;
            margin-bottom: 15px;
            color: var(--text-dark);
        }

        .hero p {
            font-size: 18px;
            color: var(--text-muted);
            max-width: 600px;
            margin: 0 auto 40px auto;
            line-height: 1.5;
        }

        /* Gallery Grid */
        .gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 24px;
            padding: 0 40px 60px 40px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .card {
            background: #fff;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            transition: transform 0.2s;
        }

        .card:hover {
            transform: translateY(-4px);
        }

        .card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            display: block;
        }

        .card-content {
            padding: 20px;
        }

        .card-content h3 {
            margin: 0 0 10px 0;
            font-size: 18px;
            color: var(--text-dark);
        }

        .card-content p {
            margin: 0;
            font-size: 14px;
            color: var(--text-muted);
            line-height: 1.4;
        }

        @media (max-width: 768px) {
            header { padding: 15px 20px; }
            .nav-links { display: none; }
            .gallery { padding: 0 20px 40px 20px; }
            .hero h1 { font-size: 36px; }
        }
    </style>
</head>
<body>

    <!-- Top Bar (Inasoma tangazo kutoka server) -->
    <div class="top-bar">
        <%= announcement %>
    </div>

    <!-- Navbar -->
    <header>
        <a href="/" class="logo">The Beauty of <span>Tanzania</span></a>
        <ul class="nav-links">
            <li><a href="/">Explore</a></li>
            <li><a href="#">Contact</a></li>
        </ul>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <h1>Discover the Magic of Tanzania</h1>
        <p>Explore breathtaking landscapes, majestic wildlife, and rich cultures through our curated visual journey.</p>
    </section>

    <!-- Gallery Grid (Inasoma picha zote zilizowekwa na Admin) -->
    <div class="gallery">
        <% if (posts.length === 0) { %>
            <p style="text-align: center; grid-column: 1 / -1; color: var(--text-muted);">Hakuna vivutio vilivyowekwa bado.</p>
        <% } %>
        <% posts.forEach(post => { %>
            <div class="card">
                <img src="<%= post.imageUrl %>" alt="<%= post.title %>">
                <div class="card-content">
                    <h3><%= post.title %></h3>
                    <p><%= post.description %></p>
                </div>
            </div>
        <% }) %>
    </div>

</body>
</html>
